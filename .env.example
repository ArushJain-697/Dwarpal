# Port the proxy listens on
PROXY_PORT=8080

# Backend pools, by path prefix (/api/a -> A, /api/b -> B).
# Comma-separated for multiple instances (load balanced round-robin).
BACKEND_A_URL=http://localhost:9001,http://localhost:9011
BACKEND_B_URL=http://localhost:9002

# WAF mode: off (no inspection) | detect (log only) | block (return 403)
WAF_MODE=block

# How often (ms) to probe each backend's /healthz
HEALTH_INTERVAL_MS=5000

# Consecutive probe results before flipping a backend up / down
HEALTH_HEALTHY_AFTER=2
HEALTH_UNHEALTHY_AFTER=3

# Circuit breaker: failures before tripping open, and cooldown before a probe
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_MS=10000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
