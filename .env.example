# Port the proxy listens on
PROXY_PORT=8080

# The backends we route to, by path prefix (/api/a -> A, /api/b -> B)
BACKEND_A_URL=http://localhost:9001
BACKEND_B_URL=http://localhost:9002

# WAF mode: off (no inspection) | detect (log only) | block (return 403)
WAF_MODE=block

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
